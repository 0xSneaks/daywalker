# AnonPad environment (copy to .env.local / Vercel env — never commit values)

# Operator mogz.fun session cookie, used ONLY server-side by the
# /api/mogz proxy route (src/app/api/mogz/[...path]/route.ts).
# Without it the launch/trade flows answer "operator session not
# configured" instead of pretending to work.
MOGZ_COOKIE=

# Optional: Solana RPC endpoint for reads + simulation.
# NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
